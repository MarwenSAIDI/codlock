{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testMatch": ["<rootDir>/test/**/*.integration-spec.ts"],
  "transform": { "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }] },
  "testEnvironment": "node",
  "clearMocks": true,
  "testTimeout": 120000,
  "maxWorkers": 1
}
