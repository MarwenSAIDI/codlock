# Copy to .env and fill in. .env is gitignored — never commit a real key.

# true  = fixtures only, no external service, no credentials needed (default)
# false = talk to Gravv for real
STUB_MODE=true
LOG_LEVEL=INFO

PAYMENT_HOST=127.0.0.1
PAYMENT_PORT=8001
PAYMENT_PUBLIC_URL=http://127.0.0.1:8001

# Sandbox Secret Key from https://app.gravv.xyz/ — Manage > Configure > API keys,
# with the Sandbox toggle on. Starts grvSec_sandbox_
# Without it the Gravv MCP loads only its two documentation tools.
GRAVV_API_KEY=

# Leave false. Only a live key AND this flag together permit real money movement.
GRAVV_ALLOW_LIVE_WRITES=false

GRAVV_TOOLSETS=customers,accounts,collections,payment-links,kyc,webhooks

# Filled in once the seller account exists in sandbox.
GRAVV_SELLER_ACCOUNT_ID=
GRAVV_SOURCE_ID=

# Gravv holds funds in stablecoin and quotes card collections in USD, while orders
# are priced in TND. Display currency stays TND; this is what Gravv is asked for.
SETTLEMENT_CURRENCY=USD

# Only used to turn a plain-text ADK delegation into a validated skill call.
# It never decides an amount and never moves money. Leave blank to refuse
# free-text requests instead of guessing at them.
GEMINI_API_KEY=
NLU_MODEL=gemini-2.5-flash
