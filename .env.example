# ─────────────────────────────────────────────────────────────
# CODLOCK Backend Core — Environment Configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Swagger UI is unauthenticated. Defaults to on outside production; set to
# true only if you deliberately want the docs public in a deployed env.
SWAGGER_ENABLED=

# ── Security / JWT (Seller Dashboard auth) ───────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
JWT_ISSUER=
JWT_AUDIENCE=

# ── Supabase (PostgreSQL: Catalog, Orders, Customers, SKUs) ──
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side only. Bypasses RLS — keep secret, never ship to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional anon key if you need RLS-scoped reads
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SCHEMA=public

# ── Firebase (Customer Risk Logs & real-time event analytics) ─
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# Paste the private key with literal \n escapes (single line), OR
# set FIREBASE_SERVICE_ACCOUNT_PATH to a JSON key file instead.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
# Local dev only: point the Admin SDK at the Firestore emulator. When set, no
# real service-account key is required (only FIREBASE_PROJECT_ID). Leave blank
# in production. Start it with: npx firebase-tools emulators:start --only firestore
FIRESTORE_EMULATOR_HOST=

# ── Codlock Orchestrator Agent (A2A entry point) ─────────────
ORCHESTRATOR_BASE_URL=http://localhost:4000
ORCHESTRATOR_API_KEY=orchestrator-shared-secret
# Resilience knobs for HTTP calls to the Orchestrator
ORCHESTRATOR_TIMEOUT_MS=15000
ORCHESTRATOR_MAX_RETRIES=3
ORCHESTRATOR_RETRY_DELAY_MS=500
# Circuit breaker
ORCHESTRATOR_CB_FAILURE_THRESHOLD=5
ORCHESTRATOR_CB_OPEN_MS=30000

# ── Gravv Payment Gateway ────────────────────────────────────
GRAVV_API_BASE_URL=https://api.gravv.fi
GRAVV_API_KEY=your-gravv-api-key
# Used to verify the HMAC signature on inbound Gravv webhooks
GRAVV_WEBHOOK_SECRET=your-gravv-webhook-signing-secret

# ── Social chat webhook trigger (WhatsApp / Instagram NLP) ───
SOCIAL_WEBHOOK_SECRET=your-social-chat-webhook-secret
# Replay window in seconds: signed chat payloads with a sentAt outside
# ±this window are rejected. Combined with per-event-id dedup.
SOCIAL_WEBHOOK_MAX_SKEW_SECONDS=300

# ── Rate limiting ────────────────────────────────────────────
# In-memory by default (per-instance). For multi-instance, wire a Redis store
# in app.module.ts and set THROTTLE_REDIS_URL. See docs.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_REDIS_URL=

# ── Risk / Deposit Engine defaults ───────────────────────────
DEPOSIT_RATE_TRUSTED=0
DEPOSIT_RATE_MEDIUM=0.10
DEPOSIT_RATE_HIGH=0.20
RISK_HIGH_THRESHOLD=70
RISK_MEDIUM_THRESHOLD=40
