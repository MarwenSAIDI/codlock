# Copy to .env and fill in. .env is gitignored - never commit a real key.

LOG_LEVEL=INFO

ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8000
ORCHESTRATOR_PUBLIC_URL=http://127.0.0.1:8000

# LLM endpoint used by the orchestrator agent (via LiteLLM).
# MODEL_NAME must be a LiteLLM-style model id, e.g. "openai/gpt-4o" for an
# OpenAI-compatible endpoint, or "anthropic/claude-sonnet-5".
MODEL_NAME=openai/your-model-name
MODEL_API_URL=https://your-model-provider.example.com/v1
MODEL_API_KEY=changeme

# Peer agents to discover over A2A, as "name=url" pairs separated by commas.
# Each url's agent card is resolved from {url}/.well-known/agent-card.json.
A2A_AGENTS=payment=http://localhost:8001,fitting=http://localhost:8002

# Supabase project used by internal tools (e.g. product lookup) and by the REST
# bridge, which reads products/orders/customers to fill in what the backend omits.
# SUPABASE_URL is the project URL; SUPABASE_KEY should be a service-role or
# other server-side key, never the anon/public key used by clients.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=changeme

# --- REST bridge: the /agent/* routes the NestJS backend calls ----------------
# Per-call budget when invoking a peer agent's skill over A2A.
PEER_CALL_TIMEOUT_SECONDS=30

# How long to poll a try-on render before answering 504. Must sit *above* the
# Fitting Agent's own PREVIEW_TIMEOUT_SECONDS (so the agent reports a slow render
# with a reason, rather than this timer cutting it off) and *below* the backend's
# ORCHESTRATOR_PREVIEW_TIMEOUT_MS (so the backend does not give up first).
PREVIEW_TIMEOUT_SECONDS=90
PREVIEW_POLL_INTERVAL_SECONDS=2
