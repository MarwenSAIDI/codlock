# Copy to .env and fill in. .env is gitignored - never commit a real key.

# true  = fixtures only, no external service, no credentials needed (default)
# false = call the image model for real
STUB_MODE=true
LOG_LEVEL=INFO

FITTING_HOST=127.0.0.1
FITTING_PORT=8002
FITTING_PUBLIC_URL=http://127.0.0.1:8002

# stub | gemini
IMAGE_PROVIDER=stub
GEMINI_API_KEY=

# Nano Banana Pro - best try-on fidelity, which is what is on screen at the pitch.
# Swap to gemini-3.1-flash-image (Nano Banana 2) if renders run long on the day.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
PREVIEW_TIMEOUT_SECONDS=60

# Only used to turn a plain-text ADK delegation into a validated skill call.
# It never chooses what to render. Blank means refuse free text, not guess at it.
NLU_MODEL=gemini-2.5-flash

# Where rendered previews are stored. Same Supabase project as the backend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PREVIEW_BUCKET=previews
