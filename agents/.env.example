# Copy to .env and fill in. .env is gitignored — never commit a real key.

# --- mode -------------------------------------------------------------------------
# true  = fixtures only, no external service, no credentials needed (default)
# false = talk to Gravv and the image model for real
STUB_MODE=true
LOG_LEVEL=INFO

# --- payment agent ----------------------------------------------------------------
PAYMENT_HOST=127.0.0.1
PAYMENT_PORT=8101
PAYMENT_PUBLIC_URL=http://127.0.0.1:8101

# Sandbox key from the Gravv dashboard. Starts grvSec_sandbox_
# Without it the Gravv MCP loads only its two documentation tools.
GRAVV_API_KEY=

# Leave false. Only a live key + this flag together permit real money movement.
GRAVV_ALLOW_LIVE_WRITES=false

GRAVV_TOOLSETS=customers,accounts,collections,payment-links,kyc,webhooks

# Filled in once the seller account exists in sandbox.
GRAVV_SELLER_ACCOUNT_ID=
GRAVV_SOURCE_ID=

# Gravv holds value in stablecoin; orders are priced in TND.
SETTLEMENT_CURRENCY=USD
TND_PER_SETTLEMENT_UNIT=3.1

# --- fitting agent ----------------------------------------------------------------
FITTING_HOST=127.0.0.1
FITTING_PORT=8102
FITTING_PUBLIC_URL=http://127.0.0.1:8102

# stub | gemini
IMAGE_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
PREVIEW_TIMEOUT_SECONDS=60

# Where rendered previews are stored. Same Supabase project as the backend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PREVIEW_BUCKET=previews
